# AIRA OS — Environment Configuration Example
# Copy this file to .env.local and fill in your actual API keys.
# NEVER commit .env or .env.local to version control!

# Supabase (Optional for cloud sync/auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Primary Intelligence (Groq Cloud)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Fallback 1 (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback 2 (OpenRouter AI)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Backend companion server
BACKEND_URL=http://10.0.2.2:8000/api/v1
