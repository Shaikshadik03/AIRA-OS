# AIRA Desktop Companion — Environment Configuration Example
# Copy this file to .env and configure your keys.
# NEVER commit .env to version control!

# Groq Cloud API Key (for Multimodal Vision and Desktop Agent Planning)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Desktop Companion Security PIN (must match mobile app pairing PIN)
AIRA_DESKTOP_PIN=123456

# Companion Port (default: 8765)
AIRA_PORT=8765
